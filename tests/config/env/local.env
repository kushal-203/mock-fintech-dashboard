# Local run: the test hooks start the backend in-process on SERVER_PORT and reset the seed data
# before every scenario. Nothing else needs to be running.
BASE_URL=http://localhost:4100
API_BASE_URL=http://localhost:4100/api
START_SERVER=true
SERVER_PORT=4100
RESET_DATA_BEFORE_EACH=true
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT_MS=10000
SCREENSHOT_ON=always
