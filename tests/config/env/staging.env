# Example deployed environment: point at a running server, don't start one. The reset endpoint
# only exists when the server runs with ENABLE_TEST_ROUTES=true, so data reset is off here.
BASE_URL=https://fintech-dashboard-staging.example.com
API_BASE_URL=https://fintech-dashboard-staging.example.com/api
START_SERVER=false
RESET_DATA_BEFORE_EACH=false
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT_MS=20000
SCREENSHOT_ON=failure
